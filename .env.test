# Test-mode env (loaded by Vite/Vitest in mode=test, overrides .env). Committed on purpose — holds
# no secrets. Forces mock mode so tests NEVER hit live APIs regardless of a dev's local .env
# (CLAUDE.md rule 3), and blanks the keys so tests don't depend on a dev's real .env values.
# Do not add real keys here.
VITE_LIVE_APIS=false
VITE_ORS_API_KEY=
VITE_DIGITRANSIT_KEY=
