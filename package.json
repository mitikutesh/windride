{
  "name": "windride",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wind-aware cycling route planner PWA — generates routes shaped by today's wind, shelter and weather.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist-keys.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check . && node scripts/check-tokens.mjs",
    "format": "prettier --write .",
    "probe:weather": "node scripts/probe-weather.mjs",
    "probe:ors": "node scripts/probe-ors.mjs",
    "probe:digitransit": "node scripts/probe-digitransit.mjs",
    "probe:ai": "node scripts/probe-ai.mjs",
    "probe:poi": "node scripts/probe-poi.mjs",
    "try:live": "vite-node scripts/try-live.ts",
    "accept": "vite-node scripts/accept.ts",
    "replay": "vite-node scripts/replay.ts",
    "gen:traces": "vite-node scripts/gen-traces.ts"
  },
  "dependencies": {
    "@turf/turf": "^7.1.0",
    "idb": "^8.0.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "axe-core": "^4.12.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vite-node": "^2.1.8",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
