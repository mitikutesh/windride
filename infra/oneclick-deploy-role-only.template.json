{
 "AWSTemplateFormatVersion": "2010-09-09",
 "Description": "WindRide GitHub deploy ROLE ONLY \u2014 for accounts that already have both the WindRideHosting stack AND the token.actions.githubusercontent.com OIDC provider. Creates just the least-privilege windride-github-deploy role.",
 "Parameters": {
  "SiteBucketName": {
   "Type": "String",
   "Description": "Existing site bucket \u2014 the WindRideHosting stack's SiteBucketName output."
  },
  "DistributionId": {
   "Type": "String",
   "Description": "Existing CloudFront distribution \u2014 the WindRideHosting stack's DistributionId output."
  }
 },
 "Resources": {
  "GitHubDeployRole": {
   "Type": "AWS::IAM::Role",
   "Properties": {
    "RoleName": "windride-github-deploy",
    "Description": "Assumed by mitikutesh/windride production-environment GitHub Actions runs via OIDC; can only sync the site bucket and invalidate the distribution.",
    "MaxSessionDuration": 3600,
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Federated": {
         "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
        }
       },
       "Action": "sts:AssumeRoleWithWebIdentity",
       "Condition": {
        "StringEquals": {
         "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
         "token.actions.githubusercontent.com:sub": [
          "repo:mitikutesh@12127634/windride@1303753936:environment:production",
          "repo:mitikutesh@12127634/windride@1303753936:ref:refs/heads/main",
          "repo:mitikutesh/windride:environment:production",
          "repo:mitikutesh/windride:ref:refs/heads/main"
         ]
        }
       }
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "site-deploy-least-privilege",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Sid": "ListSiteBucket",
         "Effect": "Allow",
         "Action": "s3:ListBucket",
         "Resource": {
          "Fn::Sub": "arn:aws:s3:::${SiteBucketName}"
         }
        },
        {
         "Sid": "WriteSiteObjects",
         "Effect": "Allow",
         "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:PutObjectAcl",
          "s3:DeleteObject"
         ],
         "Resource": {
          "Fn::Sub": "arn:aws:s3:::${SiteBucketName}/*"
         }
        },
        {
         "Sid": "InvalidateCdn",
         "Effect": "Allow",
         "Action": "cloudfront:CreateInvalidation",
         "Resource": {
          "Fn::Sub": "arn:aws:cloudfront::${AWS::AccountId}:distribution/${DistributionId}"
         }
        }
       ]
      }
     }
    ]
   }
  }
 },
 "Outputs": {
  "DeployRoleArn": {
   "Description": "GitHub secret AWS_DEPLOY_ROLE_ARN",
   "Value": {
    "Fn::GetAtt": [
     "GitHubDeployRole",
     "Arn"
    ]
   }
  }
 }
}