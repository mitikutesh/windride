# WindRide environment (see docs/API_NOTES.md §6). Copy to `.env` and fill in.
# `.env` is gitignored — never commit real keys.
#
# These env keys are the OWNER's build-time defaults. For multi-user use, each person can instead
# enter their OWN keys at runtime under Kit -> "API keys (bring your own)" (task #33): those are
# stored in their browser (IndexedDB) only, override the env values below, and never touch the
# bundle. A build shipped with VITE_LIVE_APIS=false can still go live via that screen's toggle.

# openrouteservice API key — required for live route generation (npm run dev only).
# Free tier: 2,500 req/day. Get one at https://openrouteservice.org (sign up -> token).
VITE_ORS_API_KEY=

# Strava client id (Epic 3, WR-023) — upload-only, single-player app.
VITE_STRAVA_CLIENT_ID=

# Digitransit subscription key (Epic 4, WR-026) — ranks downwind endpoints by return service.
# Free key at https://portal-api.digitransit.fi/ . Optional: with no key the downwind planner
# ranks by tailwind alone and the cards say "check return times".
VITE_DIGITRANSIT_KEY=

# Master switch for live API calls. MUST be false for tests and CI (CLAUDE.md rule 3).
# Set to true only in local `npm run dev` with real keys above.
VITE_LIVE_APIS=false

# Cognito accounts (Epic 5, WR-039) — PUBLIC config (not secrets), safe to bundle. Set these to the
# outputs of the deployed WindRideAuth CDK stack (infra/). With them unset, accounts are simply off
# and the app works fully anonymously.
VITE_COGNITO_REGION=
VITE_COGNITO_CLIENT_ID=

# Backend API base URL (Epic 5, WR-040) — PUBLIC config; set to the WindRideBackend Function URL.
# Unset ⇒ no backend (profile/sync features are simply off; the app is fully anonymous).
VITE_API_URL=
